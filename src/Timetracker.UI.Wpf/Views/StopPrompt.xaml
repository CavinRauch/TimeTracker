<Window x:Class="Timetracker.UI.Wpf.Views.StopPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StopPrompt" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Description" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" MinWidth="360" MinHeight="80" TextWrapping="Wrap"
                 AcceptsReturn="True" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Text="Metadata (key / value)" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4,0,0">
                            <TextBox Width="140" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="200" Margin="8,0,0,0"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Remove" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button Content="Add field" Command="{Binding AddFieldCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                <Button Content="OK" Width="90" IsDefault="True" Command="{Binding OkCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>