<Window x:Class="Timetracker.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timetracker" Height="400" Width="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Current.Start, TargetNullValue='Idle', StringFormat='Started: {0:t}'}" />
            <TextBlock Text="  " />
            <TextBlock Text="Elapsed:" FontWeight="Bold" Margin="12,0,8,0" />
            <TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <Button Content="Start / Stop" Command="{Binding StartStopCommand}" Width="120" />
            <Button Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" Width="80" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" />
                <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="90" />
                <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="90" />
                <DataGridTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>